# ─────────────────────────────────────────────────────────────
# Configuration Gather — variables d'environnement
# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" puis remplissez les valeurs :
#     cp .env.example .env
#
# Le fichier ".env" est ignoré par Git (voir .gitignore) : vos
# vraies clés ne seront jamais envoyées sur GitHub.
#
# Ces variables doivent commencer par EXPO_PUBLIC_ pour être
# injectées dans l'app au build (web + natif).
# ─────────────────────────────────────────────────────────────

# URL de votre projet Supabase.
# Où la trouver : Supabase → Project Settings → API → "Project URL".
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique "anon" de Supabase.
# Où la trouver : Supabase → Project Settings → API → "Project API keys" → "anon" / "public".
# Cette clé est publique par conception (elle est protégée côté serveur
# par les règles Row-Level Security), elle peut donc figurer dans l'app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
