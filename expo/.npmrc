# This project installs with bun (see bun.lock), which resolves peer dependencies
# leniently. Some packages still declare pre-React-19 peer ranges — notably
# lucide-react-native@0.475 (react ^16 || ^17 || ^18) against react 19.1.0 — so a
# strict `npm install` aborts with ERESOLVE. Keep npm as forgiving as bun for
# anyone (or any CI) that reaches for it.
legacy-peer-deps=true
